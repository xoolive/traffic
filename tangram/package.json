{
  "name": "tangram-monorepo",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "build": "corepack pnpm --filter \"./tangram_*\" build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "fmt": "prettier --write --cache \"tangram_*/**/*.{js,ts,mjs,vue}\"",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:vite": "tsc --noEmit -p tsconfig.vite.json",
    "check": "eslint && vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.vite.json",
    "verify": "corepack pnpm check && corepack pnpm build"
  },
  "devDependencies": {
    "@open-aviation/tangram-core": "^0.6.0",
    "@types/node": "^25.9.2",
    "@types/phoenix": "^1.6.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.8.0",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "jiti": "^2.7.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.61.0",
    "vite": "^8.0.16",
    "vue-tsc": "3.3.4"
  }
}
